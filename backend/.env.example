# Database connection string (SQLite fallback or PostgreSQL / Supabase)
DATABASE_URL="postgresql+psycopg2://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Google Gemini API key for AI root-cause analysis & CAPA generation
GEMINI_API_KEY="your-gemini-api-key"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Server Port
PORT=8000
